{
  "name": "raybend",
  "version": "0.1.0",
  "description": "相片管理软件（光伴）",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "lint:colors": "node scripts/check-hardcoded-colors.mjs",
    "lint:arch": "node scripts/check-architecture.mjs",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "release": "node scripts/release.mjs",
    "smoke:ui": "node --check scripts/ui-smoke.mjs && node scripts/ui-smoke.mjs",
    "check:flowbar": "node --check scripts/check-flowbar.mjs && node scripts/check-flowbar.mjs",
    "check:export": "node --check scripts/check-export-boot.mjs && node scripts/check-export-boot.mjs",
    "check:external": "node --check scripts/check-external-editor.mjs && node scripts/check-external-editor.mjs",
    "check:browse": "node --check scripts/check-browse-boot.mjs && node scripts/check-browse-boot.mjs",
    "perf:browse": "node --check scripts/perf-browse.mjs && node scripts/perf-browse.mjs",
    "perf:win": "node --check scripts/perf-win.mjs && node scripts/perf-win.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "shot": "node scripts/shot.mjs",
    "crash:drill": "bash scripts/crash-drill.sh",
    "migrate:drill": "bash scripts/migration-drill.sh",
    "check:win": "node scripts/check-win-artifact.mjs",
    "clean:win": "node --check scripts/clean-target.mjs && node scripts/clean-target.mjs",
    "clean:wsl": "node --check scripts/clean-target.mjs && node scripts/clean-target.mjs --target-dir ./target",
    "debug:win": "node --check scripts/debug-win.mjs && node scripts/debug-win.mjs",
    "spike:win": "node --check scripts/spike-win.mjs && node scripts/spike-win.mjs",
    "test:release": "node --test \"src/lib/release-plan.test.ts\" \"scripts/lib/*.test.mjs\"",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "release:finalize": "node scripts/finalize-release.mjs",
    "release:publish": "node scripts/release-publish.mjs"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.39.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@solidjs/router": "^1.0.0",
    "@tabler/icons-solidjs": "^3.46.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12"
  }
}
