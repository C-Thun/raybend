{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RayBend",
  "version": "../package.json",
  "identifier": "com.cthun.raybend",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RayBend",
        "width": 1600,
        "height": 1000,
        "minWidth": 1200,
        "minHeight": 800,
        "decorations": false,
        "transparent": true,
        "visible": false
      },
      {
        "label": "splash",
        "title": "RayBend",
        "url": "splash.html",
        "width": 800,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "desktop-behavior": {
      "browserContextMenus": false,
      "browserAcceleratorKeys": false
    },
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "windows": {
        "installMode": "basicUi"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "C-Thun",
    "licenseFile": "../LICENSE",
    "homepage": "https://raybend.cthun.com/",
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../THIRD-PARTY-NOTICES.md": "licenses/THIRD-PARTY-NOTICES.md"
    },
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      },
      "wix": {
        "upgradeCode": "3E3C4B67-6F53-4A99-AD98-421306B894B1"
      }
    }
  }
}
